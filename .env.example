# Copy to .env (gitignored). Local dev now uses AWS Bedrock (Claude Haiku), so the
# nlp-agent container needs AWS credentials with Bedrock model access.
#
# Recommended (SSO / temporary creds) — export into your shell before `make dev`:
#   aws sso login            # or: aws configure
#   eval "$(aws configure export-credentials --format env)"
# docker-compose forwards AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN / AWS_PROFILE from your shell automatically.
#
# Or set static creds here (never commit real keys):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Local-dev escape hatches. The nlp-agent process REFUSES to start when
# SKIP_JWT_VALIDATION=true is combined with ENV=production.
SKIP_JWT_VALIDATION=true
DEV_USER_BANK_CUSTOMER_ID=CUST-001
DEV_USER_GIVEN_NAME=Juan
ENV=dev
